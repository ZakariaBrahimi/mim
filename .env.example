# ClickUp API credentials.
# Generate a personal API token from ClickUp: Settings → Apps → API Token.
CLICKUP_API_TOKEN=pk_your_clickup_token_here

# The MizaniyaPay workspace ("Team") ID.
# Find it in the ClickUp URL: app.clickup.com/<WORKSPACE_ID>/...
CLICKUP_WORKSPACE_ID=90121232813

# --- Q4 2026 Roadmap (tab 1): Product Backlog + current sprint ---

# List ID of the backlog list to pull from. Defaults to "Product Backlog".
CLICKUP_BACKLOG_LIST_ID=901212762115

# Folder that contains the dated "Sprint NN (M/D - M/D)" lists. The app
# scans this folder and picks whichever sprint's date range contains today
# as the "current sprint" automatically — no need to update this each
# sprint. Defaults to the "Sprint Folder" in Mizaniya Pay 2.
CLICKUP_SPRINT_FOLDER_ID=901212077700

# Optional: force a specific sprint list instead of auto-detecting the
# current one (useful for testing, or if a sprint's name doesn't parse).
# CLICKUP_CURRENT_SPRINT_LIST_ID=901222371594

# --- Design Roadmap (tab 2): Design list only ---

CLICKUP_DESIGN_LIST_ID=901213045864

# Leave CLICKUP_API_TOKEN / CLICKUP_WORKSPACE_ID unset to run the dashboard
# fully in mock mode against the realistic MizaniyaPay seed data in
# lib/clickup/mock-data.ts.
