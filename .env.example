# ClickUp API credentials.
# Generate a personal API token from ClickUp: Settings → Apps → API Token.
CLICKUP_API_TOKEN=pk_your_clickup_token_here

# The workspace ("Team") ID that contains the MizaniyaPay spaces
# (Mobile, Partner, Payment Gateway, Admin, Operations).
# Find it in the ClickUp URL: app.clickup.com/<WORKSPACE_ID>/...
CLICKUP_WORKSPACE_ID=your_workspace_id_here

# Leave both unset to run the dashboard fully in mock mode against the
# realistic MizaniyaPay seed data in lib/clickup/mock-data.ts.
